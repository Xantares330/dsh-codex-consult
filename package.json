{
  "name": "dsh-codex-consult",
  "version": "0.1.0",
  "description": "Bring OpenAI Codex CLI into DeepSeek Harness as an on-demand consultant: deep reviews, architecture second opinions and long-evidence analysis — with verified model provenance, quota guardrails and durable call logs.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "examples/",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "codex",
    "codex-cli",
    "openai-codex",
    "consultant",
    "code-review",
    "second-opinion",
    "model-verification",
    "workflow"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meteorkid/dsh-codex-consult.git"
  },
  "homepage": "https://github.com/Meteorkid/dsh-codex-consult#readme",
  "bugs": {
    "url": "https://github.com/Meteorkid/dsh-codex-consult/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/unit.mjs",
    "test:e2e": "node test/e2e.mjs"
  }
}
